generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PHARMACY_ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  DELIVERED
  CANCELLED
}

enum DeliveryType {
  PICKUP
  HOME_DELIVERY
}

model User {
  id           String   @id @default(uuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         Role
  address      String?
  profileImage String?
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders         Order[]
  prescriptions  Prescription[]
  favourites     FavouriteMedicine[]
  notifications  Notification[]
  pharmacyUsers  PharmacyUser[]
  linkedPharmacy String?

  @@map("users")
}

model Pharmacy {
  id            String   @id @default(uuid())
  name          String
  ownerName     String
  phone         String
  email         String   @unique
  address       String
  licenseNumber String   @unique
  isActive      Boolean  @default(false)
  logoUrl       String?
  operatingHours String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  medicines     Medicine[]
  orders        Order[]
  pharmacyUsers PharmacyUser[]

  @@map("pharmacies")
}

model PharmacyUser {
  id         String   @id @default(uuid())
  userId     String
  pharmacyId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([userId, pharmacyId])
  @@map("pharmacy_users")
}

model Medicine {
  id                  String   @id @default(uuid())
  pharmacyId          String
  name                String
  genericName         String?
  brand               String?
  category            String   @default("Other")
  price               Decimal  @db.Decimal(10, 2)
  stock               Int      @default(0)
  requiresPrescription Boolean @default(false)
  imageUrl            String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  pharmacy   Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("medicines")
}

model Order {
  id           String      @id @default(uuid())
  customerId   String
  pharmacyId   String
  status       OrderStatus @default(PENDING)
  deliveryType DeliveryType
  totalAmount  Decimal     @db.Decimal(10, 2)
  notes        String?
  address      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customer      User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pharmacy      Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  prescriptions Prescription[]
  statusHistory OrderStatusHistory[]

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  medicineId   String?
  medicineName String
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine Medicine? @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model Prescription {
  id                 String   @id @default(uuid())
  orderId            String?
  customerId         String
  imageUrl           String
  notes              String?
  verifiedByPharmacy Boolean  @default(false)
  rejectionReason    String?
  uploadedAt         DateTime @default(now())

  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("prescriptions")
}

model FavouriteMedicine {
  id           String @id @default(uuid())
  customerId   String
  medicineName String
  genericName  String?
  notes        String?
  createdAt    DateTime @default(now())

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("favourite_medicines")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String?
  refId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("otp_codes")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
